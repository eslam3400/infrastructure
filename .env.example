# Traefik
DOMAIN=example.com
ACME_EMAIL=admin@example.com
TRAEFIK_DASHBOARD_USERS=admin:$$2y$$05$$...

# PostgreSQL
PG_USER=user
PG_PASSWORD=password
PG_DB=db

# MongoDB
MONGO_USERNAME=user
MONGO_PASSWORD=password
MONGO_DB=db

# Redis
REDIS_PASSWORD=password

# RustFS
RUSTFS_ACCESS_KEY=access
RUSTFS_SECRET_KEY=secret

# Hermes Agent (runs inside personal-sandbox). HERMES_PASSWORD is plain text —
# Hermes hashes it in memory.
HERMES_USERNAME=admin
HERMES_PASSWORD=changeme

# Sandboxes
# Host directory mounted as each sandbox's workspace. Point these ONLY at
# directories that contain nothing sensitive — everything under the path is
# readable/writable by the AI inside the sandbox.
FLYAKEED_WORKSPACES_PATH=/srv/workspaces/flyakeed
VECTORA_WORKSPACES_PATH=/srv/workspaces/vectora
PERSONAL_WORKSPACES_PATH=/srv/workspaces/personal
