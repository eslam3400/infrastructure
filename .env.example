# Traefik
DOMAIN=example.com
ACME_EMAIL=admin@example.com
TRAEFIK_DASHBOARD_USERS=admin:$$2y$$05$$...

# PostgreSQL
PG_USER=user
PG_PASSWORD=password
PG_DB=db

# MongoDB
MONGO_USERNAME=user
MONGO_PASSWORD=password
MONGO_DB=db

# Redis
REDIS_PASSWORD=password

# RustFS
RUSTFS_ACCESS_KEY=access
RUSTFS_SECRET_KEY=secret

# Sandboxes
HOST_WORKSPACES_PATH=~/work
