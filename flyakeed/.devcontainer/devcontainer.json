{
  "name": "flyakeed sandbox",
  "image": "flyakeed-sandbox",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--name",
    "flyakeed-sandbox"
  ],
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.1": {},
    "ghcr.io/devcontainer-community/devcontainer-features/hermes-agent.nousresearch.com:1": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-containers",
        "bmewburn.vscode-intelephense-client",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
