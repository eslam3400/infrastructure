# Machine identity bootstrap — the ONLY values that live in .env (mode 600).
# Everything below the divider lives in Infisical and is injected by make.
INFISICAL_ENVIRONMENT=dev
INFISICAL_PROJECT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Reference only — create these in Infisical, do NOT put them in .env.
#
# TRAEFIK_DASHBOARD_USERS: store the bcrypt hash with single `$` (not `$$`).

# Traefik
DOMAIN=example.com
ACME_EMAIL=admin@example.com
TRAEFIK_DASHBOARD_USERS=admin:$2y$05$...

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db

# MongoDB
MONGO_INITDB_ROOT_USERNAME=user
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=db

# Redis
REDIS_PASSWORD=password

# DBgate
DBGATE_LOGIN=admin
DBGATE_PASSWORD=change-me

# RustFS
RUSTFS_ACCESS_KEY=access
RUSTFS_SECRET_KEY=secret
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_CONSOLE_ADDRESS=:9001

# Sandbox
HOST_WORKSPACES_PATH=/absolute/path/to/work
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me
